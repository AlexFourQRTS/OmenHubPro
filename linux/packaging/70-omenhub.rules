# Lets the logged-in user talk to the HP Gaming Keyboard II (VID 0D62) HID interfaces: per-key lighting.
# Install: sudo cp 70-omenhub.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger --subsystem-match=hidraw
KERNEL=="hidraw*", ATTRS{idVendor}=="0d62", ATTRS{idProduct}=="54bf", TAG+="uaccess"
